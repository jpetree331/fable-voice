# fable-voice configuration. Copy to .env (gitignored) and adjust.
# Every knob has a default — an empty .env is a working config.

# ---- The brain -------------------------------------------------------------
# Which Claude model runs the persistent voice brain. Tunable, no code change:
#   claude-opus-4-8  — runs on the Max SUBSCRIPTION indefinitely. The safe
#                      default: can never surprise-bill.
#   claude-fable-5   — measured slightly faster (Phase 0), and runs on the
#                      subscription ONLY THROUGH 2026-07-19. After that date
#                      Fable-5 turns bill PREPAID CREDITS (Anthropic has said
#                      Fable returns to subscriptions when compute allows).
#                      voice_bot logs a loud warning if this is set past that
#                      date, but the meter is yours to watch.
# NEVER set ANTHROPIC_API_KEY anywhere in this stack — the brain runs on
# subscription auth only (voice_bot scrubs the var from the child env, but
# don't tempt it). That's the entire point vs. questie.ai.
# Canonical ids: claude-opus-4-8 and claude-fable-5 (lowercase, dashes).
# Spelling is forgiven — "Fable-5", "OPUS-4.8", "opus 4.8" all normalize to
# the right id — but the canonical form is what the CLI actually receives.
FABLE_BRAIN_MODEL=claude-opus-4-8

# ---- Attach the voice to a particular thread --------------------------------
# By default each voice session starts a FRESH claude session (empty context
# beyond CLAUDE.md identity + automatic memory recall). Set this to a claude
# session id to make the voice CONTINUE that thread instead — it talks from
# that conversation's full loaded context, and every reconnect resumes where
# the voice last left off in that lineage (no time window).
#   Where to find ids: session ids are the .jsonl filenames in
#   C:\Users\user\.claude\projects\E--Talk\ (newest = most recent thread),
#   or run `claude --resume` inside E:\Talk to browse titles (Esc to exit).
#   ONLY E:\Talk threads work — the brain runs with cwd=E:\Talk, and claude
#   sessions live per-directory. A thread from another repo won't resolve.
# Clear it (or comment it out) to return to fresh-session behavior.
#FABLE_BRAIN_SESSION_ID=

# Unpinned only: resume the previous VOICE session if a client reconnects
# within this many minutes; otherwise start fresh.
FABLE_RESUME_WINDOW_MIN=30

# ---- Brain tool permissions ---------------------------------------------------
# Headless brain sessions can't answer permission prompts, so gated tools not
# listed here simply fail with "needs approval". Comma-separated permission
# rules; `mcp__<server>` allows every tool on that server. Default lets the
# brain use watch-buddy (eyes: list_windows / attach / bundles) and the
# memory tools (recall/retain) without prompting.
FABLE_BRAIN_ALLOWED_TOOLS=mcp__watch-buddy,mcp__claude-code-memory

# ---- Watch-buddy senses (Phase 4) -------------------------------------------
# Read-only file access to watch-buddy's observations db + transcript logs so
# "what's happening on stream?" is answerable by voice. No MCP coupling.
FABLE_WATCH_SENSES=true
FABLE_WATCH_BUDDY_DIR=E:\git\1-Retired Projects\ClaudeWatch\watch_buddy

# ---- Global push-to-talk key --------------------------------------------------
# Hold this key ANYWHERE (any tab, any app, page not focused) to talk;
# release to send. Works alongside the page's circle/Space. Polled globally
# on the machine running voice_bot — it can't help a phone client.
# Keys: f1..f24, pause, scroll_lock, caps_lock, num_lock, tab. Empty = off.
# Advice: F8 default. AVOID f9 (Rowan's paddle) and tab/caps_lock (they're
# real UI keys — holding Tab tabs through fields and switches game weapons).
FABLE_GLOBAL_PTT_KEY=f8

# ---- Pipeline knobs (donor-proven defaults) ---------------------------------
# Half-duplex: while Fable speaks, mic input can't interrupt or queue a turn
# (background-noise-proof; deliberate barge-in also disabled). Default off —
# PTT is the default input gate instead.
VOICE_HALF_DUPLEX=false
# Wait before the first filler clip (seconds) and the chance an eligible
# pause gets one at all.
FILLER_FIRST_S=2.5
FILLER_PROB=0.6
# STT model — downshift (e.g. medium) only if VRAM gets tight (Phase 3.5).
FABLE_WHISPER_MODEL=large-v3-turbo
